rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function isValidMessage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000;
    }

    // Portfolio Singleton Sections (profile, settings, tabs, services, education, skills)
    match /portfolio/{docId} {
      allow read, write: if true;
    }

    // Projects collection
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Certificates collection
    match /certificates/{certificateId} {
      allow read, write: if true;
    }

    // Gallery collection
    match /gallery/{photoId} {
      allow read, write: if true;
    }

    // School Photos collection
    match /schoolPhotos/{photoId} {
      allow read, write: if true;
    }

    // Testimonials collection
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }

    // Contact Inquiries
    match /messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow read, update, delete: if true;
    }
  }
}
